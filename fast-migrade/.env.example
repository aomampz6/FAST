PORT=10300
MONGODB_URI=mongodb+srv://fast_user:replace-with-url-encoded-password@cluster0.example.mongodb.net/fast_db?retryWrites=true&w=majority&appName=FAST
JWT_SECRET=replace-with-a-64-character-random-hex-secret

# Only used once, to create the first admin account in MongoDB on server startup.
# Have no effect once an admin user already exists — change the password through
# the app after that. Never hardcoded anywhere in source; read from env and hashed
# immediately before being stored.
ADMIN_USER=admin
ADMIN_PASS=replace-with-a-long-random-admin-password
