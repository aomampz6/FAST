{
  "name": "fast-migrade",
  "version": "0.1.0",
  "description": "FAST backend rewrite — feature-based modular architecture",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "node src/server.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "seed:admin": "node src/scripts/seed-admin.js",
    "import:users": "node src/scripts/import-users.js",
    "test": "node --test"
  },
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1103.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.3",
    "multer": "^2.2.0",
    "zod": "^3.24.1"
  }
}
