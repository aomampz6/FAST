# FAST application
PORT=10300
MONGO_DATABASE=fast_db
ADMIN_USER=admin

# Coolify generates SERVICE_* values automatically.
# For local Docker Compose, replace every placeholder before starting the stack.
SERVICE_USER_MONGO=fast_admin
SERVICE_PASSWORD_MONGO=replace-with-a-long-random-password
SERVICE_HEX_64_JWT=replace-with-a-64-character-random-hex-secret
SERVICE_PASSWORD_ADMIN=replace-with-a-long-random-admin-password

# Optional: Coolify fills this when it assigns a generated domain to app port 10300.
SERVICE_FQDN_FAST_10300=
