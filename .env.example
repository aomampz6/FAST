# FAST application
PORT=10300
MONGODB_URI=mongodb+srv://fast_user:replace-with-url-encoded-password@cluster0.example.mongodb.net/fast_db?retryWrites=true&w=majority&appName=FAST
ADMIN_USER=admin

# Coolify generates these SERVICE_* secrets automatically.
SERVICE_HEX_64_JWT=replace-with-a-64-character-random-hex-secret
SERVICE_PASSWORD_ADMIN=replace-with-a-long-random-admin-password

# Optional: Coolify fills this when it assigns a generated domain to app port 10300.
SERVICE_FQDN_FAST_10300=
