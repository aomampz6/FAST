# FAST application
# These same variable names work whether you run `npm start` / `node server.js`
# directly, `docker compose up`, or deploy on Coolify — no renaming needed anywhere.
PORT=10300
MONGODB_URI=mongodb+srv://fast_user:replace-with-url-encoded-password@cluster0.example.mongodb.net/fast_db?retryWrites=true&w=majority&appName=FAST
JWT_SECRET=replace-with-a-64-character-random-hex-secret

# ADMIN_USER/ADMIN_PASS are only used once, to create the first admin account in
# MongoDB on server startup. They have no effect once an admin user already exists —
# change the admin password through the admin panel after that.
ADMIN_USER=admin
ADMIN_PASS=replace-with-a-long-random-admin-password

# Optional: Coolify fills this when it assigns a generated domain to app port 10300.
SERVICE_FQDN_FAST_10300=
